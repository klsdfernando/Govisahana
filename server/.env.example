# GoviSahana Backend Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/govisahana

# Resend is the primary provider for registration and password-reset OTP emails.
# Verify developer.sushanfer.dev in Resend before using this sender in production.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=givisahana@developer.sushanfer.dev

# Optional Gmail SMTP fallback
# Use your Gmail address below
EMAIL_USER=your_gmail@gmail.com
# Use a Gmail App Password (NOT your real Gmail password)
# To get one: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_PASS=your_gmail_app_password
